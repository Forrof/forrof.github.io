---
import { render, type CollectionEntry } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import { publishedCves, fullDate } from '../../lib/content';
import { assignedCve, advisoryStatus } from '../../lib/advisories';
export async function getStaticPaths() {
  return (await publishedCves()).map((entry) => ({ params: { id: entry.data.identifier.toLowerCase() }, props: { entry } }));
}
interface Props { entry: CollectionEntry<'cves'> }
const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;
const cve = assignedCve(data);
---
<SiteLayout title={data.title} description={data.summary} section="cves" reading>
  <a class="ff-back" href="/cves/">← all disclosures</a>
  <article class="ff-article">
    <h1>{data.title}</h1>
    <div class="ff-byline ff-meta"><span>forrof</span><time datetime={data.published}>{fullDate(data.published)}</time><span>[advisory]</span>{data.updated && <span>updated <time datetime={data.updated}>{fullDate(data.updated)}</time></span>}</div>
    <dl class="ff-facts">
      <dt>Status</dt><dd>{advisoryStatus(data)}</dd>
      {cve && <><dt>CVE</dt><dd>{cve}</dd></>}
      {data.identifier.startsWith('GHSA-') && <><dt>Advisory</dt><dd><a href={data.creditSource}>{data.identifier} ↗</a></dd></>}
      <dt>Product</dt><dd>{data.product}</dd>
      <dt>Affected</dt><dd>{data.affected}</dd>
      <dt>Fixed</dt><dd>{data.fixed}</dd>
      <dt>Credit</dt><dd><a href={data.creditSource}>Public attribution ↗</a></dd>
      {data.severity && <><dt>Severity</dt><dd><a href={data.severity.source}>{data.severity.label} ({data.severity.system}) ↗</a></dd></>}
      {data.verified && <><dt>Last verified</dt><dd><time datetime={data.verified}>{fullDate(data.verified)}</time></dd></>}
    </dl>
    <div class="ff-prose">
      <Content />
      {data.timeline.length > 0 && <><h2 id="disclosure-timeline"><a class="heading-anchor" href="#disclosure-timeline">Disclosure timeline</a></h2><ul>{data.timeline.map((item) => <li><time datetime={item.date}>{fullDate(item.date)}</time> — {item.event}</li>)}</ul></>}
      <h2 id="references"><a class="heading-anchor" href="#references">References</a></h2>
      <ul class="ff-reference-list">{data.references.map((reference) => <li><a href={reference.url}>{reference.label} ↗</a></li>)}</ul>
    </div>
    <div class="ff-article-tail"><a href="/cves/">← all disclosures</a><span class="ff-meta">{data.tags.join(' · ')}</span></div>
  </article>
</SiteLayout>

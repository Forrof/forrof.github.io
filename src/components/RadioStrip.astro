---
import { loadRadioTracks } from '../lib/radio';
const tracks = loadRadioTracks();
const first = tracks[0];
---
{first && <section class="ff-radio" data-radio data-state="idle" aria-label="forrof radio" transition:persist="forrof-radio" hidden>
  <div class="ff-radio-bar">
    <span class="ff-radio-brand">forrof <span>/ radio</span><span class="ff-radio-meter" aria-hidden="true"><span>▂</span><span>▆</span><span>▄</span><span>█</span><span>▃</span></span></span>
    <button class="ff-radio-toggle" data-radio-toggle type="button" aria-label="Play radio">[play]</button>
    <button class="ff-radio-track" data-radio-track type="button" aria-expanded="false" aria-controls="radio-tracks" aria-label={`Choose track; selected ${first.title} by ${first.artist}`}>
      <span data-radio-title>{first.title}</span><span class="ff-radio-artist" data-radio-artist>{first.artist}</span>
    </button>
    <div class="ff-radio-progress">
      <input data-radio-seek type="range" min="0" max="1000" step="1" value="0" aria-label="Seek in track" aria-valuetext="0:00" disabled />
      <span class="ff-radio-time" data-radio-time>0:00 / —</span>
    </div>
    <label class="ff-radio-volume">vol<input data-radio-volume type="range" min="0" max="100" step="1" value="25" aria-label="Radio volume" aria-valuetext="25%" /></label>
  </div>
  <ol class="ff-radio-tracks" id="radio-tracks" data-radio-list hidden>
    {tracks.map((track, index) => <li><button type="button" data-radio-choice data-src={track.src} data-title={track.title} data-artist={track.artist} data-credit={track.credit} data-artist-url={track.artistUrl} aria-current={index === 0 ? 'true' : undefined}><span>{track.title}</span><span class="ff-radio-artist">{track.artist}</span></button></li>)}
  </ol>
  <p class="ff-radio-credit"><span data-radio-credit>{first.credit ?? `Music by ${first.artist}`}</span><a data-radio-artist-link href={first.artistUrl} hidden={!first.artistUrl} target="_blank" rel="noopener noreferrer">artist ↗</a></p>
  <p class="ff-radio-status" data-radio-status role="status" aria-live="polite" hidden></p>
  <audio data-radio-audio preload="none" hidden></audio>
</section>}

---
import { displayDate } from '../lib/content';
interface Props { title: string; href: string; summary: string; published: string; type: string; tags: string[]; index: number; status?: string; cve?: string; headingLevel?: 'h2' | 'h3' }
const { title, href, summary, published, type, tags, index, status, cve, headingLevel: Heading = 'h2' } = Astro.props;
---
<article class="ff-entry">
  <span class="ff-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
  <div>
    <div class="ff-title-row">
      <Heading><a href={href}>{title}</a></Heading>
      <span class="ff-leader" aria-hidden="true"></span>
      <time class="ff-meta" datetime={published}>{displayDate(published)}</time>
    </div>
    <p class="ff-summary">{summary}</p>
    <div class="ff-tags"><span class="ff-type">[{type}]</span>{cve && <a class="ff-cve-id" href={`https://nvd.nist.gov/vuln/detail/${cve}`}>{cve} ↗</a>}{status && <span class="ff-status">Status: {status}</span>}{tags.map((tag) => <span>{tag}</span>)}</div>
  </div>
</article>

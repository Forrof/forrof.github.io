---
import { displayDate } from '../lib/content';
interface Props { title: string; href: string; summary: string; published: string; type: string; tags: string[]; index: number; status?: string }
const { title, href, summary, published, type, tags, index, status } = Astro.props;
---
<article class="ff-entry">
  <span class="ff-index" aria-hidden="true">{String(index).padStart(2, '0')}</span>
  <div>
    <div class="ff-title-row">
      <h2><a href={href}>{title}</a></h2>
      <span class="ff-leader" aria-hidden="true"></span>
      <time class="ff-meta" datetime={published}>{displayDate(published)}</time>
    </div>
    <p class="ff-summary">{summary}</p>
    <div class="ff-tags"><span class="ff-type">[{type}]</span>{status && <span class="ff-status">Status: {status}</span>}{tags.map((tag) => <span>{tag}</span>)}</div>
  </div>
</article>

{
  "name": "forrof-archive",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.1",
    "@astrojs/sitemap": "3.7.4",
    "@fontsource-variable/literata": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.3.2",
    "rehype-autolink-headings": "7.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "linkedom": "0.18.13",
    "typescript": "~5.9.3"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "start": "npm run dev",
    "check": "astro check",
    "build": "astro sync --force && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "test": "node --test tests/*.test.mjs",
    "validate": "npm run check && npm run build && npm test"
  }
}
